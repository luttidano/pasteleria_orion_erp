# =============================================================================
# PASTELERÍA ORIÓN ERP — VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# Copia este archivo como .env y completa los valores con tus credenciales:
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase (Producción / Cloud Auth y Base de Datos)
# Obtén estos valores en tu panel de Supabase:
# Configuración del Proyecto -> API (Project Settings -> API)
# -----------------------------------------------------------------------------
# URL pública de tu instancia de Supabase (Project URL)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Clave pública anónima (anon / public key) - Segura para el navegador cliente
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Clave de servicio de Supabase (service_role key) - SOLO para backend / scripts administrativos
# NUNCA la expongas en el frontend ni en variables VITE_*
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL (Supabase / Prisma)
# Panel Supabase -> Project Settings -> Database -> Connection string (URI)
# Modo Directo (Puerto 5432) o Connection Pooling / PgBouncer (Puerto 6543)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[TU-PASSWORD]@db.[TU-PROYECTO].supabase.co:5432/postgres?schema=public"

# -----------------------------------------------------------------------------
# 3. Backend (NestJS API)
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# -----------------------------------------------------------------------------
# 4. Frontend Web (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# 5. Cloudflare R2 (Almacenamiento de Imágenes y Archivos Pesados)
# En Supabase solo se guardan IDs, textos y la URL pública (image_url).
# Las imágenes y fotos de productos se sirven desde Cloudflare R2 / CDN.
# -----------------------------------------------------------------------------
VITE_CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"
# CLOUDFLARE_ACCOUNT_ID="tu-account-id"
# CLOUDFLARE_R2_ACCESS_KEY_ID="tu-access-key-id"
# CLOUDFLARE_R2_SECRET_ACCESS_KEY="tu-secret-access-key"
# CLOUDFLARE_R2_BUCKET_NAME="pasteleria-orion-assets"

