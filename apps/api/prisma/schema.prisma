datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id        String   @id @db.Uuid
  name      String
  email     String?
  role      String   @default("baker")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales                     PosSale[]
  closedPeriods             AccountingPeriod[]   @relation("PeriodClosedBy")
  reopenedPeriods           AccountingPeriod[]   @relation("PeriodReopenedBy")
  voidedEntries             AccountingEntry[]    @relation("EntryVoidedBy")
  updatedAccountingSettings AccountingSettings[] @relation("AccountingSettingsUpdatedBy")
  openedShifts              PosShift[]           @relation("ShiftOpenedBy")
  closedShifts              PosShift[]           @relation("ShiftClosedBy")
  stockMovements            StockMovement[]      @relation("StockMovementCreatedBy")
  createdInvoices           SupplierInvoice[]    @relation("InvoiceCreatedBy")
  supplierPayments          SupplierPayment[]    @relation("PaymentCreatedBy")

  @@map("profile")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  type        String   @default("ingredient")
  description String?
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ingredients Ingredient[]
  recipes     Recipe[]
  products    Product[]

  @@unique([name, type])
  @@map("category")
}

model Ingredient {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  categoryId          String?              @map("category_id") @db.Uuid
  stock               Decimal              @default(0) @db.Decimal(12, 3)
  minStock            Decimal              @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit                String               @default("kg")
  price               Decimal?             @default(0) @db.Decimal(12, 2)
  icon                String?
  imageUrl            String?              @map("image_url")
  description         String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  categoryRef         Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeIngredients   RecipeIngredient[]
  supplierIngredients SupplierIngredient[]

  @@map("ingredient")
}

model Recipe {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  yieldServings Int                @default(1) @map("yield_servings")
  categoryId    String?            @map("category_id") @db.Uuid
  imageUrl      String?            @map("image_url")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  categoryRef   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients   RecipeIngredient[]
  products      Product[]

  @@index([isActive], map: "idx_recipe_is_active")
  @@map("recipe")
}

model RecipeIngredient {
  id           String     @id @default(uuid()) @db.Uuid
  recipeId     String     @map("recipe_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  quantity     Decimal    @db.Decimal(12, 3)
  unit         String     @default("g")
  createdAt    DateTime   @default(now()) @map("created_at")
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredients  Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredient")
}

model Supplier {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  phone             String
  deliverySchedule  String   @map("delivery_schedule")
  category          String
  approximatePrices String   @map("approximate_prices")
  contactPerson     String?  @map("contact_person")
  icon              String?  @default("🚚")
  email             String?
  address           String?
  notes             String?
  supplierTypes     String[] @default(["materia_prima"]) @map("supplier_types")
  supplyModality    String   @default("despacho") @map("supply_modality")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  supplierIngredients SupplierIngredient[]
  resaleProducts      Product[]
  packagings          Packaging[]
  generalSupplies     GeneralSupply[]
  invoices            SupplierInvoice[]

  @@map("supplier")
}

model SupplierIngredient {
  id           String     @id @default(uuid()) @db.Uuid
  supplierId   String     @map("supplier_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  costPrice    Decimal?   @default(0) @map("cost_price") @db.Decimal(12, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  supplier     Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([supplierId, ingredientId])
  @@map("supplier_ingredient")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  productType  String   @map("product_type")
  stock        Decimal       @default(0) @db.Decimal(12, 3)
  minStock     Decimal       @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit         String        @default("un")
  salePrice    Decimal       @default(0) @map("sale_price") @db.Decimal(12, 2)
  costPrice    Decimal?      @default(0) @map("cost_price") @db.Decimal(12, 2)
  recipeId     String?       @map("recipe_id") @db.Uuid
  supplierId   String?       @map("supplier_id") @db.Uuid
  categoryId   String?       @map("category_id") @db.Uuid
  imageUrl     String?       @map("image_url")
  icon         String?       @default("🧁")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  recipe       Recipe?       @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryRef  Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  posSaleItems PosSaleItem[]

  @@index([isActive], map: "idx_product_is_active")
  @@map("product")
}

model Packaging {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  packageType String   @map("package_type")
  category    String
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  minStock    Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit        String   @default("un")
  costPrice   Decimal? @default(0) @map("cost_price") @db.Decimal(12, 2)
  salePrice   Decimal  @default(0) @map("sale_price") @db.Decimal(12, 2)
  supplierId  String?  @map("supplier_id") @db.Uuid
  icon        String?  @default("📦")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  posSaleItems PosSaleItem[]

  @@index([supplierId], map: "idx_packaging_supplier")
  @@index([packageType], map: "idx_packaging_package_type")
  @@index([isActive], map: "idx_packaging_is_active")
  @@map("packaging")
}

model GeneralSupply {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  category    String
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  minStock    Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit        String   @default("un")
  costPrice   Decimal? @default(0) @map("cost_price") @db.Decimal(12, 2)
  supplierId  String?  @map("supplier_id") @db.Uuid
  icon        String?  @default("🧤")
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([supplierId], map: "idx_general_supply_supplier")
  @@index([category], map: "idx_general_supply_category")
  @@map("general_supply")
}

model PosSale {
  id                String   @id @default(uuid()) @db.Uuid
  ticketNumber      String   @unique @map("ticket_number")
  paymentMethod     String   @map("payment_method")
  subtotal          Decimal  @db.Decimal(12, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total             Decimal  @db.Decimal(12, 2)
  status            String   @default("completada")
  accountingStatus  String   @default("posted") @map("accounting_status")
  accountingError   String?  @map("accounting_error")
  soldAt            DateTime @default(now()) @map("sold_at") @db.Timestamptz(6)
  dataOrigin        String   @default("demo") @map("data_origin")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdById       String?  @map("created_by") @db.Uuid
  createdBy         Profile? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  shiftId           String?  @map("shift_id") @db.Uuid
  shift             PosShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  items PosSaleItem[]
  accountingEntries AccountingEntry[]

  @@index([createdById], map: "idx_pos_sale_created_by")
  @@index([shiftId], map: "idx_pos_sale_shift_id")
  @@index([soldAt], map: "idx_pos_sale_sold_at")
  @@index([paymentMethod], map: "idx_pos_sale_payment_method")
  @@index([status], map: "idx_pos_sale_status")
  @@map("pos_sale")
}

model PosSaleItem {
  id          String     @id @default(uuid()) @db.Uuid
  saleId      String     @map("sale_id") @db.Uuid
  productId   String?    @map("product_id") @db.Uuid
  packagingId String?    @map("packaging_id") @db.Uuid
  productName String     @map("product_name")
  quantity    Int
  unitPrice   Decimal    @map("unit_price") @db.Decimal(12, 2)
  unitCost    Decimal    @default(0) @map("unit_cost") @db.Decimal(12, 2)
  lineTotal   Decimal    @map("line_total") @db.Decimal(12, 2)
  sale        PosSale    @relation(fields: [saleId], references: [id], onDelete: Cascade, map: "pos_sale_items_sale_id_fkey")
  product     Product?   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pos_sale_items_product_id_fkey")
  packaging   Packaging? @relation(fields: [packagingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pos_sale_items_packaging_id_fkey")

  @@index([saleId], map: "idx_pos_sale_item_sale_id")
  @@index([productId], map: "idx_pos_sale_item_product_id")
  @@index([packagingId], map: "idx_pos_sale_item_packaging")

  @@map("pos_sale_item")
}

model AccountingAccount {
  id          String                @id @default(uuid()) @db.Uuid
  code        String                @unique
  name        String
  accountType String                @map("account_type")
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  entryItems  AccountingEntryItem[]

  @@map("accounting_account")
}

model AccountingEntry {
  id              String                @id @default(uuid()) @db.Uuid
  entryNumber     BigInt                @default(autoincrement()) @map("entry_number")
  entryDate       DateTime              @default(now()) @map("entry_date") @db.Date
  concept         String
  origin          String                @default("manual")
  status          String                @default("active")
  posSaleId       String?               @map("pos_sale_id") @db.Uuid
  posShiftId      String?               @map("pos_shift_id") @db.Uuid
  outboxId        String?               @map("outbox_id") @db.Uuid
  voidedAt        DateTime?             @map("voided_at") @db.Timestamptz(6)
  voidedById      String?               @map("voided_by") @db.Uuid
  voidReason      String?               @map("void_reason")
  reversedEntryId String?               @map("reversed_entry_id") @db.Uuid
  closingYear     Int?                  @map("closing_year")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  posSale         PosSale?              @relation(fields: [posSaleId], references: [id])
  posShift        PosShift?             @relation("ShiftDifferenceEntry", fields: [posShiftId], references: [id], onDelete: SetNull)
  outbox          AccountingOutbox?     @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  voidedBy        Profile?              @relation("EntryVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  reversedEntry   AccountingEntry?      @relation("EntryReversal", fields: [reversedEntryId], references: [id], onDelete: SetNull)
  reversalEntries AccountingEntry[]     @relation("EntryReversal")
  closingPeriods  AccountingPeriod[]    @relation("PeriodClosingEntry")
  posShifts       PosShift[]            @relation("ShiftClosingEntry")
  supplierPayments SupplierPayment[]    @relation("PaymentAccountingEntry")
  items           AccountingEntryItem[]

  @@index([posSaleId], map: "idx_accounting_entry_pos_sale")
  @@index([posShiftId], map: "idx_accounting_entry_pos_shift")
  @@index([outboxId], map: "idx_accounting_entry_outbox")
  @@index([reversedEntryId], map: "idx_accounting_entry_reversed")
  @@index([status, entryDate], map: "idx_accounting_entry_status_date")
  @@index([entryDate], map: "idx_accounting_entry_date")
  @@map("accounting_entry")
}

model AccountingEntryItem {
  id          String            @id @default(uuid()) @db.Uuid
  entryId     String            @map("entry_id") @db.Uuid
  accountId   String            @map("account_id") @db.Uuid
  debit       Decimal           @default(0) @db.Decimal(12, 2)
  credit      Decimal           @default(0) @db.Decimal(12, 2)
  description String?

  entry       AccountingEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     AccountingAccount @relation(fields: [accountId], references: [id])

  @@index([accountId], map: "idx_accounting_entry_item_account")
  @@index([entryId], map: "idx_accounting_entry_item_entry")
  @@map("accounting_entry_item")
}

model AccountingPeriod {
  id             String           @id @default(uuid()) @db.Uuid
  year           Int
  month          Int
  status         String           @default("abierto")
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz(6)
  closedById     String?          @map("closed_by") @db.Uuid
  reopenedAt     DateTime?        @map("reopened_at") @db.Timestamptz(6)
  reopenedById   String?          @map("reopened_by") @db.Uuid
  closingEntryId String?          @map("closing_entry_id") @db.Uuid
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  closedBy     Profile?         @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  reopenedBy   Profile?         @relation("PeriodReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)
  closingEntry AccountingEntry? @relation("PeriodClosingEntry", fields: [closingEntryId], references: [id], onDelete: SetNull)

  @@unique([year, month], map: "uq_accounting_period_year_month")
  @@index([status], map: "idx_accounting_period_status")
  @@map("accounting_period")
}

model AccountingSettings {
  id                  String    @id @default("default")
  accountingStartDate DateTime? @map("accounting_start_date") @db.Date
  updatedById         String?   @map("updated_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy Profile? @relation("AccountingSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("accounting_settings")
}

model PosShift {
  id                String    @id @default(uuid()) @db.Uuid
  shiftNumber       BigInt    @default(autoincrement()) @map("shift_number")
  status            String    @default("abierto")
  openedAt          DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  openedById        String?   @map("opened_by") @db.Uuid
  openingCash       Decimal   @default(0) @map("opening_cash") @db.Decimal(12, 2)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)
  closedById        String?   @map("closed_by") @db.Uuid
  totalSales        Decimal   @default(0) @map("total_sales") @db.Decimal(12, 2)
  transactionsCount Int       @default(0) @map("transactions_count")
  cashSalesTotal    Decimal   @default(0) @map("cash_sales_total") @db.Decimal(12, 2)
  debitTotal        Decimal   @default(0) @map("debit_total") @db.Decimal(12, 2)
  creditTotal       Decimal   @default(0) @map("credit_total") @db.Decimal(12, 2)
  transferTotal     Decimal   @default(0) @map("transfer_total") @db.Decimal(12, 2)
  cardPosTotal      Decimal   @default(0) @map("card_pos_total") @db.Decimal(12, 2)
  expectedCash      Decimal   @default(0) @map("expected_cash") @db.Decimal(12, 2)
  countedCash       Decimal?  @map("counted_cash") @db.Decimal(12, 2)
  cashDifference    Decimal?  @map("cash_difference") @db.Decimal(12, 2)
  notes             String?
  closingEntryId    String?   @map("closing_entry_id") @db.Uuid
  accountingStatus  String    @default("none") @map("accounting_status")
  accountingWarning String?   @map("accounting_warning")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  openedBy          Profile?          @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy          Profile?          @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closingEntry      AccountingEntry?  @relation("ShiftClosingEntry", fields: [closingEntryId], references: [id], onDelete: SetNull)
  sales             PosSale[]
  differenceEntries AccountingEntry[] @relation("ShiftDifferenceEntry")

  @@index([status], map: "idx_pos_shift_status")
  @@index([openedAt], map: "idx_pos_shift_opened_at")
  @@index([closedAt], map: "idx_pos_shift_closed_at")
  @@index([openedById], map: "idx_pos_shift_opened_by")
  @@index([closedById], map: "idx_pos_shift_closed_by")
  @@index([closingEntryId], map: "idx_pos_shift_closing_entry")
  @@map("pos_shift")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  actorKey       String   @map("actor_key")
  method         String
  route          String
  requestHash    String   @map("request_hash")
  status         String   @default("processing")
  statusCode     Int?     @map("status_code")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt      DateTime @default(dbgenerated("(now() + '24:00:00'::interval)")) @map("expires_at") @db.Timestamptz(6)

  @@unique([actorKey, method, route, idempotencyKey], map: "uq_idempotency_scope")
  @@index([expiresAt], map: "idx_idempotency_record_expires_at")
  @@map("idempotency_record")
}

model AccountingOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  businessDate  DateTime  @map("business_date") @db.Timestamptz(6)
  referenceCode String    @map("reference_code")
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)

  entries       AccountingEntry[]

  @@unique([aggregateType, aggregateId], map: "uq_accounting_outbox_aggregate")
  @@index([status, businessDate], map: "idx_accounting_outbox_pending_date")
  @@map("accounting_outbox")
}

model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  itemType      String   @map("item_type")
  itemId        String   @map("item_id") @db.Uuid
  itemName      String   @map("item_name")
  movementType  String   @map("movement_type")
  quantityDelta Decimal  @map("quantity_delta") @db.Decimal(12, 3)
  unit          String
  stockBefore   Decimal  @map("stock_before") @db.Decimal(12, 3)
  stockAfter    Decimal  @map("stock_after") @db.Decimal(12, 3)
  unitCost      Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  totalCost     Decimal  @default(0) @map("total_cost") @db.Decimal(12, 2)
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  reason        String?
  createdById   String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy     Profile? @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([itemType, itemId, createdAt], map: "idx_stock_movement_item_date")
  @@index([movementType, createdAt], map: "idx_stock_movement_type_date")
  @@index([referenceType, referenceId], map: "idx_stock_movement_reference")
  @@map("stock_movement")
}

model SupplierInvoice {
  id            String            @id @default(uuid()) @db.Uuid
  supplierId    String            @map("supplier_id") @db.Uuid
  invoiceNumber String            @map("invoice_number") @db.VarChar(100)
  issueDate     DateTime          @default(now()) @map("issue_date") @db.Date
  dueDate       DateTime          @map("due_date") @db.Date
  totalAmount   Decimal           @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status        String            @default("pending") @db.VarChar(20)
  hasInvoice    Boolean           @default(true) @map("has_invoice")
  notes         String?
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier      Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy     Profile?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments      SupplierPayment[]

  @@unique([supplierId, invoiceNumber], map: "uq_supplier_invoice_number")
  @@index([supplierId], map: "idx_supplier_invoice_supplier")
  @@index([status], map: "idx_supplier_invoice_status")
  @@index([dueDate], map: "idx_supplier_invoice_due_date")
  @@map("supplier_invoice")
}

model SupplierPayment {
  id                String           @id @default(uuid()) @db.Uuid
  invoiceId         String           @map("invoice_id") @db.Uuid
  paymentDate       DateTime         @default(now()) @map("payment_date") @db.Date
  amount            Decimal          @map("amount") @db.Decimal(12, 2)
  paymentMethod     String           @map("payment_method") @db.VarChar(50)
  reference         String?          @db.VarChar(150)
  notes             String?
  accountingEntryId String?          @map("accounting_entry_id") @db.Uuid
  createdById       String?          @map("created_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice           SupplierInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  accountingEntry   AccountingEntry? @relation("PaymentAccountingEntry", fields: [accountingEntryId], references: [id], onDelete: SetNull)
  createdBy         Profile?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId], map: "idx_supplier_payment_invoice")
  @@index([paymentDate], map: "idx_supplier_payment_date")
  @@map("supplier_payment")
}

