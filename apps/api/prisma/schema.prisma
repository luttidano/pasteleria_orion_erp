datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

enum Role {
  admin
  cashier
  baker
  user
}

enum CategoryType {
  ingredient
  recipe
  pos
}

model Profile {
  id        String   @id @db.Uuid
  name      String
  email     String?
  role      Role     @default(baker)
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  type        CategoryType  @default(ingredient)
  description String?
  icon        String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  ingredients Ingredient[]
  recipes     Recipe[]

  @@unique([name, type])
  @@map("category")
}

model Ingredient {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  categoryId        String?             @map("category_id") @db.Uuid
  stock             Decimal             @default(0) @db.Decimal(12, 3)
  minStock          Decimal             @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit              String              @default("kg")
  price             Decimal?            @default(0) @db.Decimal(12, 2)
  icon              String?
  imageUrl          String?             @map("image_url")
  description       String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  categoryRef       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeIngredients RecipeIngredient[]
  @@map("ingredient")
}
model Recipe {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  yieldServings   Int                @default(1) @map("yield_servings")
  categoryId      String?            @map("category_id") @db.Uuid
  imageUrl        String?            @map("image_url")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  categoryRef     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients     RecipeIngredient[]
  @@map("recipe")
}
model RecipeIngredient {
  id                String            @id @default(uuid()) @db.Uuid
  recipeId          String            @map("recipe_id") @db.Uuid
  ingredientId      String            @map("ingredient_id") @db.Uuid
  quantity          Decimal           @db.Decimal(12, 3)
  unit              String            @default("g")
  createdAt         DateTime          @default(now()) @map("created_at")
  recipe            Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredients       Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredient")
}
