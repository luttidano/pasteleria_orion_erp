datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id        String   @id @db.Uuid
  name      String
  email     String?
  role      String   @default("baker")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  type        String   @default("ingredient")
  description String?
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ingredients Ingredient[]
  recipes     Recipe[]
  products    Product[]

  @@unique([name, type])
  @@map("category")
}

model Ingredient {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  categoryId          String?              @map("category_id") @db.Uuid
  stock               Decimal              @default(0) @db.Decimal(12, 3)
  minStock            Decimal              @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit                String               @default("kg")
  price               Decimal?             @default(0) @db.Decimal(12, 2)
  icon                String?
  imageUrl            String?              @map("image_url")
  description         String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  categoryRef         Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeIngredients   RecipeIngredient[]
  supplierIngredients SupplierIngredient[]

  @@map("ingredient")
}

model Recipe {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  yieldServings Int                @default(1) @map("yield_servings")
  categoryId    String?            @map("category_id") @db.Uuid
  imageUrl      String?            @map("image_url")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  categoryRef   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients   RecipeIngredient[]
  products      Product[]

  @@map("recipe")
}

model RecipeIngredient {
  id           String     @id @default(uuid()) @db.Uuid
  recipeId     String     @map("recipe_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  quantity     Decimal    @db.Decimal(12, 3)
  unit         String     @default("g")
  createdAt    DateTime   @default(now()) @map("created_at")
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredients  Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredient")
}

model Supplier {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  phone             String
  deliverySchedule  String   @map("delivery_schedule")
  category          String
  approximatePrices String   @map("approximate_prices")
  contactPerson     String?  @map("contact_person")
  icon              String?  @default("🚚")
  email             String?
  address           String?
  notes             String?
  supplierType      String   @default("materia_prima") @map("supplier_type")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  supplierIngredients SupplierIngredient[]
  resaleProducts      Product[]

  @@map("supplier")
}

model SupplierIngredient {
  id           String     @id @default(uuid()) @db.Uuid
  supplierId   String     @map("supplier_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  costPrice    Decimal?   @default(0) @map("cost_price") @db.Decimal(12, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  supplier     Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([supplierId, ingredientId])
  @@map("supplier_ingredient")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  productType  String   @map("product_type")
  stock        Decimal       @default(0) @db.Decimal(12, 3)
  minStock     Decimal       @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit         String        @default("un")
  salePrice    Decimal       @default(0) @map("sale_price") @db.Decimal(12, 2)
  costPrice    Decimal?      @default(0) @map("cost_price") @db.Decimal(12, 2)
  recipeId     String?       @map("recipe_id") @db.Uuid
  supplierId   String?       @map("supplier_id") @db.Uuid
  categoryId   String?       @map("category_id") @db.Uuid
  imageUrl     String?       @map("image_url")
  icon         String?       @default("🧁")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  recipe       Recipe?       @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryRef  Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  posSaleItems PosSaleItem[]

  @@map("product")
}

model PosSale {
  id                String   @id @default(uuid()) @db.Uuid
  ticketNumber      String   @unique @map("ticket_number")
  paymentMethod     String   @map("payment_method")
  subtotal          Decimal  @db.Decimal(12, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total             Decimal  @db.Decimal(12, 2)
  status            String   @default("completada")
  accountingStatus  String   @default("posted") @map("accounting_status")
  accountingError   String?  @map("accounting_error")
  soldAt            DateTime @default(now()) @map("sold_at") @db.Timestamptz(6)
  dataOrigin        String   @default("demo") @map("data_origin")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  items PosSaleItem[]
  accountingEntries AccountingEntry[]

  @@index([soldAt], map: "idx_pos_sale_sold_at")
  @@index([paymentMethod], map: "idx_pos_sale_payment_method")
  @@index([status], map: "idx_pos_sale_status")
  @@map("pos_sale")
}

model PosSaleItem {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  sale        PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade, map: "pos_sale_items_sale_id_fkey")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "pos_sale_items_product_id_fkey")

  @@index([saleId], map: "idx_pos_sale_item_sale_id")
  @@index([productId], map: "idx_pos_sale_item_product_id")

  @@map("pos_sale_item")
}

model AccountingAccount {
  id          String                @id @default(uuid()) @db.Uuid
  code        String                @unique
  name        String
  accountType String                @map("account_type")
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  entryItems  AccountingEntryItem[]

  @@map("accounting_account")
}

model AccountingEntry {
  id          String                @id @default(uuid()) @db.Uuid
  entryNumber BigInt                @default(autoincrement()) @map("entry_number")
  entryDate   DateTime              @default(now()) @map("entry_date") @db.Date
  concept     String
  origin      String                @default("manual")
  posSaleId   String?               @map("pos_sale_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  posSale     PosSale?              @relation(fields: [posSaleId], references: [id])
  items       AccountingEntryItem[]

  @@map("accounting_entry")
}

model AccountingEntryItem {
  id          String            @id @default(uuid()) @db.Uuid
  entryId     String            @map("entry_id") @db.Uuid
  accountId   String            @map("account_id") @db.Uuid
  debit       Decimal           @default(0) @db.Decimal(12, 2)
  credit      Decimal           @default(0) @db.Decimal(12, 2)
  description String?

  entry       AccountingEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     AccountingAccount @relation(fields: [accountId], references: [id])

  @@map("accounting_entry_item")
}

