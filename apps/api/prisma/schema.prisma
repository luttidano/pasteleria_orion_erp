datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  cashier
  baker
}

enum CategoryType {
  ingredient
  recipe
  pos
}

model Profile {
  id        String   @id @db.Uuid
  name      String
  email     String?
  role      Role     @default(baker)
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  type        CategoryType  @default(ingredient)
  description String?
  icon        String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  ingredients Ingredient[]
  recipes     Recipe[]
  products        Product[]

  @@unique([name, type])
  @@map("category")
}

model Ingredient {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String
  categoryId          String?             @map("category_id") @db.Uuid
  stock               Decimal             @default(0) @db.Decimal(12, 3)
  minStock            Decimal             @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit                String              @default("kg")
  price               Decimal?            @default(0) @db.Decimal(12, 2)
  icon                String?
  imageUrl            String?             @map("image_url")
  description         String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  categoryRef         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeIngredients   RecipeIngredient[]
  supplierIngredients SupplierIngredient[]
  @@map("ingredient")
}

model Recipe {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  yieldServings   Int                @default(1) @map("yield_servings")
  categoryId      String?            @map("category_id") @db.Uuid
  imageUrl        String?            @map("image_url")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  categoryRef     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients     RecipeIngredient[]
  products        Product[]
  @@map("recipe")
}

model RecipeIngredient {
  id                String            @id @default(uuid()) @db.Uuid
  recipeId          String            @map("recipe_id") @db.Uuid
  ingredientId      String            @map("ingredient_id") @db.Uuid
  quantity          Decimal           @db.Decimal(12, 3)
  unit              String            @default("g")
  createdAt         DateTime          @default(now()) @map("created_at")
  recipe            Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredients       Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredient")
}

enum SupplierType {
  materia_prima
  reventa
  ambos
}

enum ProductType {
  manufactured
  resale
}

model Supplier {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String
  phone               String
  deliverySchedule    String        @map("delivery_schedule")
  category            String
  approximatePrices   String        @map("approximate_prices")
  contactPerson       String?       @map("contact_person")
  icon                String?       @default("🚚")
  email               String?
  address             String?
  notes               String?
  supplierType        SupplierType  @default(materia_prima) @map("supplier_type")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @default(now()) @map("updated_at")

  supplierIngredients SupplierIngredient[]
  resaleProducts      Product[]

  @@map("supplier")
}

model SupplierIngredient {
  id           String     @id @default(uuid()) @db.Uuid
  supplierId   String     @map("supplier_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  costPrice    Decimal?   @default(0) @map("cost_price") @db.Decimal(12, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  supplier     Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  @@unique([supplierId, ingredientId])
  @@map("supplier_ingredient")
}


model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  description String?
  productType ProductType @map("product_type")
  stock       Decimal     @default(0) @db.Decimal(12, 3)
  minStock    Decimal     @default(0) @map("min_stock") @db.Decimal(12, 3)
  unit        String      @default("un")
  salePrice   Decimal     @default(0) @map("sale_price") @db.Decimal(12, 2)
  costPrice   Decimal?    @default(0) @map("cost_price") @db.Decimal(12, 2)
  recipeId    String?     @map("recipe_id") @db.Uuid
  supplierId  String?     @map("supplier_id") @db.Uuid
  categoryId  String?     @map("category_id") @db.Uuid
  imageUrl    String?     @map("image_url")
  icon        String?     @default("🧁")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")
  recipe      Recipe?     @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryRef Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@map("product")
}


