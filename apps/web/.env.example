# =============================================================================
# PASTELERÍA ORIÓN ERP — FRONTEND WEB (.env.example)
# =============================================================================
# Si despliegas esta aplicación en Vercel, Netlify o Cloudflare Pages,
# configura las siguientes variables de entorno en el panel de tu proveedor:
# =============================================================================

# URL pública de tu instancia de Supabase (Project Settings -> API)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Clave pública anónima (anon / public key)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# URL base del Backend NestJS (opcional para consumo de endpoints futuros)
VITE_API_URL="http://localhost:3001"

# URL pública de Cloudflare R2 para servir imágenes y multimedia
VITE_CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

